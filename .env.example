# .env.example

# Core settings
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=sqlite:///./launchguard.db
BACKEND_CORS_ORIGINS=http://localhost:3000

# Security and scanning limits
SCANNER_TIMEOUT_SECONDS=30
MAX_PAGES_PER_SCAN=25
MAX_CRAWL_DEPTH=2
MAX_CONCURRENCY=2

# Optional AI provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional GitHub integration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
